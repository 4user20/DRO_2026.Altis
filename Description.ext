class CfgDebriefing
{  
	class DROEnd_Full
	{
		title = "Операция завершена";
		subtitle = "";
		description = "Ключевые задачи выполнены. Противник потерял часть разведывательных, огневых и логистических возможностей в районе операции.";
		pictureBackground = "images\recon_image_notext.jpg";
		picture = "";
		pictureColor[] = {0.0,0.3,0.6,1};
	};
	class DROEnd_Partial
	{
		title = "Операция завершена";
		subtitle = "";
		description = "Часть задач выполнить не удалось. Обстановка изменилась, а последующие действия потребуют нового замысла.";
		pictureBackground = "images\recon_image_notext.jpg";
		picture = "";
		pictureColor[] = {0.0,0.3,0.6,1};
	};
	class DROEnd_Fail
	{
		title = "Операция провалена";
		subtitle = "";
		description = "Ни одна из поставленных задач не выполнена. Противник сохранил логистику, огневую поддержку и свободу действий.";
		pictureBackground = "images\recon_image_notext.jpg";
		picture = "";
		pictureColor[] = {0.5,0.4,0.4,1};
	};
	class DROEnd_FailCiv1
	{
		title = "Операция провалена";
		subtitle = "Недопустимые потери среди гражданских";
		description = "После завершения операции действия группы были подробно разобраны командованием. Потери среди гражданских осложнили обстановку, снизили доверие к союзным силам и перечеркнули часть достигнутого результата.";
		pictureBackground = "images\recon_image_notext.jpg";
		picture = "";
		pictureColor[] = {0.5,0.4,0.4,1};
	};
	class DROEnd_FailCiv2
	{
		title = "Операция провалена";
		subtitle = "Недопустимые потери среди гражданских";		
		description = "Недопустимые потери среди гражданских привели к провалу операции. Противник использовал произошедшее в информационных целях, а достигнутые тактические результаты потеряли значение.";
		pictureBackground = "images\recon_image_notext.jpg";
		picture = "";
		pictureColor[] = {0.5,0.4,0.4,1};
	};
};

